NODE_ENV=production
MEDUSA_ADMIN_ONBOARDING_TYPE=default
MEDUSA_MIGRATIONS_MODE=auto

# Drop the per-request access log. At the default level every storefront call
# writes a JSON line, which is what ate the disk on the VPS.
LOG_LEVEL=warn

STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

DATABASE_URL=postgres://postgres:postgres@postgres:5432/medusa

JWT_SECRET=replace_with_strong_secret
COOKIE_SECRET=replace_with_strong_secret

# Storefront cache invalidation (must match storefront REVALIDATE_SECRET)
STOREFRONT_URL=http://storefront:3000
REVALIDATE_SECRET=replace_with_strong_secret

# Notifications
RESEND_API_KEY=
RESEND_FROM=

# Optional Cloudinary settings
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_FOLDER_NAME=medusa
