# Server crontab for garden-for-you (skriney/saddlyavas).
#
# Install:
#   crontab /opt/repositories/garden-for-you-monorepo/scripts/monitor/crontab.example
# Check:
#   crontab -l
#
# Requires /etc/garden-monitor.env with BOT_TOKEN and CHAT_ID, chmod 600.
# Paths are spelled out in full because cron does not expand shell variables
# inside a command.

SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Stack health: disk usage, Postgres, backend API, storefront.
# Alerts only when a check changes state, so an outage will not spam you.
*/5 * * * * /opt/repositories/garden-for-you-monorepo/scripts/monitor/health-check.sh >> /var/log/garden-health.log 2>&1

# Database dump to Backblaze B2.
0 */6 * * * /opt/repositories/garden-for-you-monorepo/scripts/monitor/pg-backup.sh >> /var/log/garden-pg-backup.log 2>&1

# Second line of defence: complains if the newest backup in B2 is over 24h old,
# which is what you see when the job above never ran at all. Offset to :30 so it
# does not race the dump.
30 * * * * /opt/repositories/garden-for-you-monorepo/scripts/monitor/check-backups.sh >> /var/log/garden-backups.log 2>&1

# Weekly docker cleanup. Dangling images left behind by pulling the :latest tag
# filled the disk once and took the whole site down with it.
15 4 * * 0 /bin/sh -c 'docker image prune -af; docker builder prune -af' >> /var/log/garden-prune.log 2>&1
